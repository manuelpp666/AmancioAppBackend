# Plantilla del .env del backend. Copiar como .env y rellenar.
# El .env real NO se sube al repositorio (está en .gitignore).

# ---------------------------------------------------------------- ENTORNO
# 'produccion' en el servidor, cualquier otra cosa (o vacío) en local.
# En produccion: la cookie de sesión pasa a SameSite=None + Secure (necesario
# porque el frontend está en otro dominio) y se desactiva /docs.
ENTORNO=produccion

# ------------------------------------------------------------ BASE DE DATOS
DB_USER=root
DB_PASS=contraseña_bd
DB_HOST=localhost:nombre_puerto_bd
DB_NAME=nombre_bd



# -------------------------------------------------------------- SEGURIDAD
# Cadena larga y aleatoria. Si cambia, se invalidan todas las sesiones abiertas.
"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
