# Copia este archivo a `.env` y rellénalo. NUNCA subas `.env` al repositorio.

# --- Base de datos MySQL ------------------------------------------------------
DB_USER=
DB_PASS=
# "host" o "host:puerto", p. ej. mi-servidor.com:3306
DB_HOST=
DB_NAME=

# --- JWT ----------------------------------------------------------------------
# Cadena larga y aleatoria (mínimo 32 caracteres). Si cambia, se invalidan las sesiones.
# Generar una:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Entorno ------------------------------------------------------------------
# desarrollo | produccion
ENTORNO=desarrollo
# Solo si pruebas la app en navegador (Expo web). Separados por comas.
ALLOWED_ORIGINS=
# 10 a 16. Más bajo = login más rápido, menos seguro.
BCRYPT_ROUNDS=12
