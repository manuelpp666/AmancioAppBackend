{
  "info": {
    "name": "AmancioApp API",
    "_postman_id": "a34393d1-f7d2-4159-aa6e-0aa19fc8bfbe",
    "description": "API de la app móvil AmancioApp (Flask + JWT).\n\n1. Arranca el servidor: `.venv/Scripts/python run.py`\n2. Ejecuta **Sesión / Login**: guarda el token solo.\n3. Prueba las demás peticiones.\n\nPara entrar con otro usuario cambia `username` y `password` en las variables de la colección (usuarios de prueba en `app/base_nueva.py`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "username",
      "value": "ALU-33333333"
    },
    {
      "key": "password",
      "value": "33333333"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Salud del servidor",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": []
        },
        "description": "Comprueba que el servidor está encendido.",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Sesión",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "description": "Devuelve el access_token y el rol. El script de Tests lo guarda en la variable `token`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token del login para usarlo en las demás peticiones",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().access_token);",
                  "}",
                  "pm.test('Login correcto', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con clave incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"clave-mala\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza la clave', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
